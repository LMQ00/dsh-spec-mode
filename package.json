{
  "name": "dsh-spec-mode",
  "version": "2.1.0",
  "type": "module",
  "scripts": {
    "test": "node selftest.mjs && node landing-test.mjs",
    "flow": "node doc-flow.mjs"
  },
  "description": "Spec mode for the DeepSeek Harness: interview-driven requirements capture that lands a requirement brief for a later model and a flow-chart image for a person.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LMQ00/dsh-spec-mode.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis"
  ],
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "icon": "./icon.svg",
  "files": [
    "index.js",
    "state.js",
    "guard.js",
    "advisories.js",
    "prompt.js",
    "brief.js",
    "flow.js",
    "flow-svg.js",
    "rasterize.js",
    "cordis.patch.yml",
    "selftest.mjs",
    "landing-test.mjs",
    "doc-flow.mjs",
    "README.md",
    "LICENSE",
    "icon.svg",
    ".spec/flow.png",
    "locale/*.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
