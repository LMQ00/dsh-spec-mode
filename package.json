{
  "name": "dsh-spec-mode",
  "version": "1.3.1",
  "type": "module",
  "description": "Spec mode for the DeepSeek Harness: interview-driven requirements capture with a read-only working tree.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LMQ00/dsh-spec-mode.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis"
  ],
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "icon": "./icon.svg",
  "files": [
    "index.js",
    "state.js",
    "guard.js",
    "advisories.js",
    "prompt.js",
    "cordis.patch.yml",
    "selftest.mjs",
    "README.md",
    "LICENSE",
    "docs/*.md",
    "icon.svg",
    "locale/*.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
