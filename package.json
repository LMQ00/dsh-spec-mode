{
  "name": "dsh-spec-mode",
  "version": "4.0.0",
  "type": "module",
  "scripts": {
    "test": "node selftest.mjs && node landing-test.mjs",
    "flow": "node doc-flow.mjs"
  },
  "description": "Spec mode for the DeepSeek Harness: interview-driven requirements capture that lands a chart collection under .spec/flows/ — one overview, the module charts it points at, and one requirement brief per chart — plus a conversation view that reads and edits them.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LMQ00/dsh-spec-mode.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "icon": "./icon.svg",
  "files": [
    "index.js",
    "state.js",
    "guard.js",
    "advisories.js",
    "prompt.js",
    "brief.js",
    "flows.js",
    "flows-api.js",
    "chart-md.js",
    "mermaid-graph.js",
    "client.js",
    "cordis.patch.yml",
    "selftest.mjs",
    "landing-test.mjs",
    "doc-flow.mjs",
    "README.md",
    "docs",
    "LICENSE",
    "icon.svg",
    ".spec/flows/*.md",
    "locale/*.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
